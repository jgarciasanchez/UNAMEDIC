<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BindingContext="{Binding Menu}" 
             x:Class="Salud.Views.MenuPage"
             Title="{Binding Title}"
             >
    
    <ContentPage.Content>
        <!--<StackLayout BindingContext="{Binding Login}" Padding="10,0,10,0" VerticalOptions="Center">
            <Button VerticalOptions="Center" Text="Login" Command="{Binding LoginCommand}"/>
        </StackLayout>-->
        
        <StackLayout  BackgroundColor="Azure">
            <ScrollView VerticalOptions="FillAndExpand">
                <StackLayout VerticalOptions="FillAndExpand"
                    Padding="5"
                    Spacing="5">

                    <Image Source="UNAMEDIC_LOGO" WidthRequest="250" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"/>
                    <StackLayout Orientation="Horizontal" HorizontalOptions="CenterAndExpand">
                        <Label Text="Nombre:" FontSize="Medium"/>
                        <Label Text="{ Binding Nombre }" FontSize="Medium"/>
                    </StackLayout>
                    <StackLayout Orientation="Horizontal" HorizontalOptions="CenterAndExpand">
                        <Label Text="Fecha Nacimiento:" FontSize="Medium"/>
                        <Label Text="{ Binding FechaNacimiento }" FontSize="Medium"/>
                    </StackLayout>
                    <StackLayout Orientation="Horizontal" HorizontalOptions="CenterAndExpand">
                        <Label Text="Sexo:" FontSize="Medium"/>
                        <Label Text="{ Binding Sexo }" FontSize="Medium"/>
                    </StackLayout>
                    <StackLayout Orientation="Horizontal" HorizontalOptions="CenterAndExpand">
                        <Label Text="IMC:" FontSize="Medium"/>
                        <Label Text="{ Binding IMC }" FontSize="Medium"/>
                    </StackLayout>

                    <Grid Margin="10" Padding="0" VerticalOptions="EndAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="150" />
                            <RowDefinition Height="150" />
                        </Grid.RowDefinitions>

                        <Button ImageSource="azucar" Text="Diabetes" Command="{Binding OnDiabetesClicked}" ContentLayout="Top,0" 
                                BackgroundColor="Azure" BorderColor="LightBlue" TextColor="Black" BorderWidth="5" CornerRadius="15"/>

                        <Button Grid.Column="1" ImageSource="presion" Text="Presión Arterial" Command="{Binding OnHipertensionClicked}" ContentLayout="Top,0" 
                                BackgroundColor="Azure" BorderColor="LightBlue" TextColor="Black" BorderWidth="5" CornerRadius="15"/>

                        <Button Grid.Row="1" ImageSource="sangre" Text="Control de Donaciones" Command="{Binding OnSangreClicked}" ContentLayout="Top,0" 
                                BackgroundColor="Azure" BorderColor="LightBlue" TextColor="Black" BorderWidth="5" CornerRadius="15"/>

                        <Button Grid.Row="1" Grid.Column="1" ImageSource="hidratacion" Text="Control de Hidratación" Command="{Binding OnAguaClicked}" ContentLayout="Top,0" 
                                BackgroundColor="Azure" BorderColor="LightBlue" TextColor="Black" BorderWidth="5" CornerRadius="15"/>

                    </Grid>
                </StackLayout>
            </ScrollView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>