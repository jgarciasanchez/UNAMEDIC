<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BindingContext="{Binding Main, Source={StaticResource Locator}}"
             x:Class="Salud.Views.MenuPage"
             Title="Menu"
             >
    
    <ContentPage.Content>
        <!--<StackLayout BindingContext="{Binding Login}" Padding="10,0,10,0" VerticalOptions="Center">
            <Button VerticalOptions="Center" Text="Login" Command="{Binding LoginCommand}"/>
        </StackLayout>-->
        
        <StackLayout  BindingContext="{Binding Menu}" BackgroundColor="Azure">
            <ScrollView VerticalOptions="FillAndExpand">
                <StackLayout VerticalOptions="FillAndExpand"
                    Padding="5"
                    Spacing="5">

                    <Image Source="UNAMEDIC" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"/>
                    <Grid Margin="10" Padding="0" VerticalOptions="EndAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="150" />
                            <RowDefinition Height="150" />
                        </Grid.RowDefinitions>

                        <BoxView Grid.Row="0" Color="LightBlue" CornerRadius="10" Margin="5"/>
                        <BoxView Grid.Row="0" Color="Azure" CornerRadius="10" Margin="8"/>
                        <Label Grid.Row="0"
                            Text="Diabetes"
                            HorizontalOptions="CenterAndExpand"
                            VerticalOptions="CenterAndExpand"
                            BackgroundColor="Azure"
                            TextColor="Black"
                            FontSize="Default"/>
                        <Button Grid.Row="0" Grid.Column="0" Opacity="0" Command="{Binding OnDiabetesClicked}"/>

                        <BoxView Grid.Column="1" Color="LightBlue" CornerRadius="10" Margin="5"/>
                        <BoxView Grid.Column="1" Color="Azure" CornerRadius="10" Margin="8"/>
                        <Label Grid.Column="1"
                            Text="Hipertensión"
                            HorizontalOptions="CenterAndExpand"
                            VerticalOptions="CenterAndExpand"
                            BackgroundColor="Azure"
                            TextColor="Black"
                            FontSize="Default"/>
                        <Button Grid.Row="0" Grid.Column="1" Opacity="0" Command="{Binding OnHipertensionClicked}"/>

                        <BoxView Grid.Row="1" Color="LightBlue" CornerRadius="10"  Margin="5"/>
                        <BoxView Grid.Row="1" Color="Azure" CornerRadius="10"  Margin="8"/>
                        <Label Grid.Row="1"
                            Text="Control de donación"
                            HorizontalOptions="CenterAndExpand"
                            VerticalOptions="CenterAndExpand"
                            BackgroundColor="Azure"
                            TextColor="Black"
                            FontSize="Default"/>
                        <Button Grid.Row="1" Grid.Column="0" Opacity="0" Command="{Binding OnSangreClicked}"/>

                        <BoxView Grid.Row="1" Grid.Column="1" Color="LightBlue" CornerRadius="10" Margin="5"/>
                        <BoxView Grid.Row="1" Grid.Column="1" Color="Azure" CornerRadius="10" Margin="8"/>
                        <Label Grid.Row="1"
                            Grid.Column="1"
                            Text="Control de hidratación"
                            HorizontalOptions="CenterAndExpand"
                            VerticalOptions="CenterAndExpand"
                            BackgroundColor="Azure"
                            TextColor="Black"
                            FontSize="Default"/>
                        <Button Grid.Row="1" Grid.Column="1" Opacity="0" Command="{Binding OnAguaClicked}"/>

                    </Grid>
                </StackLayout>
            </ScrollView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>