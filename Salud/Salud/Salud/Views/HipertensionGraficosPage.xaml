<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Salud.Views.HipertensionGraficosPage"
              BindingContext="{Binding Hipertension}"
             xmlns:forms="clr-namespace:Microcharts.Forms;assembly=Microcharts.Forms"
             Title="Gráficos">
    <ContentPage.Content>
        <ScrollView>
        <Grid VerticalOptions="Center" Margin="-15" Scale=".95">
            <StackLayout Spacing="0">
                <Label Text="Nivel de sistólica de los últimos cinco registros"
                VerticalOptions="Start" 
                HorizontalOptions="CenterAndExpand" />
                <forms:ChartView Chart="{Binding LineCharts}" HeightRequest="200" WidthRequest="100"/>
            </StackLayout>
            <StackLayout Grid.Row="1" >
                <Label Text="Nivel de diastólica de los últimos cinco registros"
                VerticalOptions="Start" 
                HorizontalOptions="CenterAndExpand" />
                <forms:ChartView Chart="{Binding BarCharts}" HeightRequest="200" WidthRequest="100"/>
            </StackLayout>
            <StackLayout Grid.Row="2" >
                <Label Text="Pulso de los últimos cinco registros"
                VerticalOptions="Start" 
                HorizontalOptions="CenterAndExpand" />
                    <forms:ChartView Chart="{Binding LineCharts3}" HeightRequest="200" WidthRequest="100"/>
            </StackLayout>
            </Grid>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>