<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Salud.Views.DiabetesGraficsPage"
             xmlns:forms="clr-namespace:Microcharts.Forms;assembly=Microcharts.Forms"
             Title="Gráficos">
             
    <ContentPage.Content>
        <Grid VerticalOptions="Center">
            <StackLayout BindingContext="{Binding Diabetes}" >
                <Label Text="Nivel de glucosa de los últimos cinco registros"
                VerticalOptions="Start" 
                HorizontalOptions="CenterAndExpand" />
                <forms:ChartView Chart="{Binding LineCharts}" HeightRequest="200" WidthRequest="100"/>
            </StackLayout>
            <StackLayout Grid.Row="1" BindingContext="{Binding Diabetes}" >
                <Label Text="Nivel de glucosa de los últimos cinco registros"
                VerticalOptions="Start" 
                HorizontalOptions="CenterAndExpand" />
                <forms:ChartView Chart="{Binding BarCharts}" HeightRequest="200" WidthRequest="100"/>
            </StackLayout>
        </Grid>
    </ContentPage.Content>
</ContentPage>